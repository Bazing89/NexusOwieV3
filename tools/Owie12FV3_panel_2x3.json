{
  "layout": {
    "type": "grid",
    "rows": 3,
    "cols": 2,
    "space": "2mm",
    "rotation": "0deg",
    "alternation": "none",
    "renamenet": "Board_{n}-{orig}",
    "renameref": "{orig}"
  },
  "source": {
    "type": "auto",
    "tolerance": "1mm",
    "stack": "2layer"
  },
  "tabs": {
    "type": "fixed",
    "width": "3mm",
    "vcount": 0,
    "hcount": 2,
    "mindistance": "8mm"
  },
  "cuts": {
    "type": "mousebites",
    "drill": "0.5mm",
    "spacing": "1mm",
    "offset": "-0.2mm",
    "prolong": "0.5mm"
  },
  "framing": {
    "type": "frame",
    "width": "5mm",
    "space": "2mm",
    "cuts": "both",
    "fillet": "1mm"
  },
  "tooling": {
    "type": "4hole",
    "hoffset": "3mm",
    "voffset": "3mm",
    "size": "2mm",
    "paste": false
  },
  "fiducials": {
    "type": "3fid",
    "hoffset": "10mm",
    "voffset": "2.5mm",
    "coppersize": "1mm",
    "opening": "2mm",
    "paste": false
  },
  "post": {
    "type": "auto",
    "millradius": "1mm",
    "reconstructarcs": true,
    "refillzones": false,
    "dimensions": true,
    "origin": "bl"
  }
}
